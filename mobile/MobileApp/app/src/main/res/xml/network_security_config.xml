<?xml version="1.0" encoding="utf-8"?>
<!-- The development API (dotnet run, http profile) serves plain HTTP, which Android blocks
     by default from API 28. Cleartext is allowed only for these development hosts; every
     other host still needs HTTPS. To test on a real phone, add your computer's LAN IP here
     and use the same IP in ApiConfig.BASE_URL. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The computer running the API, as seen from the Android emulator -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
