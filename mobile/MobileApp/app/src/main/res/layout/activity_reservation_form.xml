<?xml version="1.0" encoding="utf-8"?>
<!-- New / modify reservation. The grid node, date, time and duration fields open
     picker dialogs; errors for those show in the red text under each one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout style="@style/TopBar">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/reservations_back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/tvTitle"
            style="@style/TopBarTitle"
            android:layout_marginStart="4dp"
            android:text="@string/reservation_form_new_title" />
    </LinearLayout>

    <View style="@style/Divider" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/formContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- Only shown when modifying -->
            <TextView
                android:id="@+id/tvModifyNote"
                style="@style/Banner"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_banner_info"
                android:textColor="@color/info_text"
                android:visibility="gone" />

            <!-- Grid node -->
            <TextView
                style="@style/FormLabel"
                android:text="@string/reservation_node_label" />

            <TextView
                android:id="@+id/tvNode"
                style="@style/FormPicker"
                android:hint="@string/reservation_node_hint" />

            <TextView
                android:id="@+id/tvNodeError"
                style="@style/FormError" />

            <!-- Drop-off or charging -->
            <TextView
                style="@style/FormLabel"
                android:text="@string/reservation_type_label" />

            <RadioGroup
                android:id="@+id/rgType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:checkedButton="@+id/rbDropOff"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbDropOff"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_option"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/reservation_type_drop_off"
                    android:textColor="@color/option_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbCharging"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_option"
                    android:button="@null"
                    android:gravity="center"
                    android:text="@string/reservation_type_charging"
                    android:textColor="@color/option_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvTypeHelp"
                style="@style/FormHelper"
                android:text="@string/reservation_type_drop_off_help" />

            <!-- Date and start time side by side -->
            <LinearLayout
                android:id="@+id/rowWhen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="3"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/reservation_date_label" />

                    <TextView
                        android:id="@+id/tvDate"
                        style="@style/FormPicker"
                        android:hint="@string/reservation_date_hint" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FormLabel"
                        android:text="@string/reservation_time_label" />

                    <TextView
                        android:id="@+id/tvTime"
                        style="@style/FormPicker"
                        android:hint="@string/reservation_time_hint" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FormHelper"
                android:text="@string/reservation_window_helper" />

            <TextView
                android:id="@+id/tvWhenError"
                style="@style/FormError" />

            <!-- Duration -->
            <TextView
                style="@style/FormLabel"
                android:text="@string/reservation_duration_label" />

            <TextView
                android:id="@+id/tvDuration"
                style="@style/FormPicker" />

            <!-- Energy amount -->
            <TextView
                style="@style/FormLabel"
                android:text="@string/reservation_energy_label" />

            <EditText
                android:id="@+id/etEnergy"
                style="@style/FormInput"
                android:hint="@string/reservation_energy_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="6" />

            <TextView
                style="@style/FormHelper"
                android:text="@string/reservation_energy_helper" />

            <Button
                android:id="@+id/btnSubmit"
                style="@style/WideButton.Primary"
                android:layout_marginTop="28dp"
                android:text="@string/reservation_submit_new" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
