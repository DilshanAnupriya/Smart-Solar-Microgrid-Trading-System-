<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fitsSystemWindows="true">

    <!-- Camera Preview Surface / TextureView -->
    <TextureView
        android:id="@+id/textureCameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Darkened Vignette Overlay with transparent center viewport -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#CC000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/operator_scanner_title"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnToggleTorch"
                style="@style/ButtonOutline"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_btn_outline"
                android:paddingHorizontal="12dp"
                android:text="Torch"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Instruction Text -->
        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:paddingHorizontal="32dp"
            android:text="@string/operator_scanner_instruction"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Viewfinder Reticle Box -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <View
                android:id="@+id/viewReticle"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_scanner_reticle" />

            <!-- Animated Laser Line in Center -->
            <View
                android:id="@+id/viewLaserLine"
                android:layout_width="240dp"
                android:layout_height="2dp"
                android:layout_gravity="center"
                android:background="#FFFF5722" />

            <ProgressBar
                android:id="@+id/progressVerifying"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom Controls / Manual Fallback -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E61A1E24"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Test Seeded QRs:"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <!-- Quick Demo Chips for Immediate Viva Testing -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDemoColombo"
                        style="@style/ButtonOutline"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="10dp"
                        android:text="Colombo (Approved)"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnDemoKandy"
                        style="@style/ButtonOutline"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="10dp"
                        android:text="Kandy (Charging)"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnDemoPending"
                        style="@style/ButtonOutline"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:paddingHorizontal="10dp"
                        android:text="Pending (D404)"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnDemoGalle"
                        style="@style/ButtonOutline"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:paddingHorizontal="10dp"
                        android:text="Galle (Under 12h)"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Manual Reference Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etManualReference"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input_left"
                    android:hint="@string/operator_scanner_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnVerifyManual"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="-1dp"
                    android:background="@drawable/bg_btn_primary"
                    android:paddingHorizontal="14dp"
                    android:stateListAnimator="@null"
                    android:text="Verify"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Gallery Picker Option -->
            <Button
                android:id="@+id/btnPickGallery"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_outline"
                android:text="@string/operator_scanner_gallery"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
