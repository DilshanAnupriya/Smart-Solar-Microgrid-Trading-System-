<?xml version="1.0" encoding="utf-8"?>
<!-- The FrameLayout takes the system-bar and keyboard insets as padding, so the ScrollView
     itself shrinks when the keyboard opens and scrolls the focused field into view -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Logo: sun icon on a rounded orange square -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_logo"
                android:contentDescription="@string/login_logo_description"
                android:padding="14dp"
                android:src="@drawable/ic_sun" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/login_title"
                android:textColor="@color/text_dark"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/login_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <!-- NIC or email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/login_identifier_label"
                android:textColor="@color/text_dark"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/etIdentifier"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:autofillHints="username"
                android:background="@drawable/bg_input"
                android:hint="@string/login_identifier_hint"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:nextFocusDown="@id/etPassword"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_dark"
                android:textColorHint="@color/text_muted"
                android:textSize="16sp" />

            <!-- Password -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/login_password_label"
                android:textColor="@color/text_dark"
                android:textSize="16sp" />

            <!-- Password field and Show/Hide button side by side -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autofillHints="password"
                    android:background="@drawable/bg_input_left"
                    android:fontFamily="sans-serif"
                    android:hint="@string/login_password_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_muted"
                    android:textSize="16sp" />

                <!-- -1dp margin overlaps the two 1dp borders so the seam is a single line -->
                <Button
                    android:id="@+id/btnTogglePassword"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="-1dp"
                    android:background="@drawable/bg_btn_outline"
                    android:minWidth="72dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="16dp"
                    android:stateListAnimator="@null"
                    android:text="@string/login_show_password"
                    android:textAllCaps="false"
                    android:textColor="@color/btn_outline_text"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- The API's reason when sign-in fails, e.g. wrong details or a deactivated account -->
            <TextView
                android:id="@+id/tvFormError"
                style="@style/Banner"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_banner_danger"
                android:textColor="@color/danger_text"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"
                android:text="@string/login_sign_in"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <!-- Link to prosumer self-registration -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_no_account"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvGoToRegister"
                    style="@style/TextLink"
                    android:text="@string/login_go_to_register" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
