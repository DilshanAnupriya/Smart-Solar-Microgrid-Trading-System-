<?xml version="1.0" encoding="utf-8"?>
<!-- Grey outline button with all corners rounded, filled grey while pressed
     (Bootstrap btn-outline-secondary); used for Cancel -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_muted" />
            <stroke android:width="1dp" android:color="@color/text_muted" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/text_muted" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
